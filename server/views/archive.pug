extends layout

block js
  // Drawphone JS
  script(src=`${js}`)

block content
  div
    span.glyphicon.glyphicon-pencil(aria-hidden='true',style="padding-right:2px;")
    span.glyphicon.glyphicon-earphone(aria-hidden='true',style="padding-left:2px;")
  #archive
    h2 Tus Resultados Anteriores
    p Ver los resultados guardados en este dispositivo
    hr
    #archive-content.btn-group-vertical(role="group" aria-label="...")
    br
  #result.hidden
      h2#title Cargando archivo...
      p#subtitle Esto puede tardar un segundo
      hr
      div#result-content
      br
      #result-others.btn-group-vertical(role='group', aria-label='...')
      br
      br
      .btn-toolbar#result-buttons
        button#result-done.btn.btn-default.btn-lg(type='button') Hecho
  br
  a.btn.btn-default.btn-lg(type='button', href="/") Salir del Archivo
