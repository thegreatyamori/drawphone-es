extends layout

block js
  // Drawphone JS
  script(src=`${js}`)

block content
  .mt-3.mb-2
    img.mr-1(src='pencil-alt.svg' alt='' width='18')
    img.ml-1(src='phone-alt.svg' alt='' width='18')
  h1#title Drawphone
  p#subtitle Teléfono con dibujos
  hr
  div#loading Cargando...
  div#mainmenu.d-none
    include announcements.pug
    .btn-toolbar.mt-3
      a.btn.btn-default.btn-lg.mr-2(href="https://rocketcrab.com/join",type='button') Unirse a la Fiesta
      a.btn.btn-default.btn-lg(href="https://rocketcrab.com/transfer/drawphone",type='button') Iniciar Fiesta
    .mt-3.mb-3
      |Powered by 
      img.rocketsvg.ml-1(src='https://rocketcrab.com/rocket.svg' alt='' width='16')
      img.crabsvg.ml-1(src='https://rocketcrab.com/crab.svg' alt='' width='16')
      a.rocketcrablink(href="https://rocketcrab.com", target='_blank') rocketcrab.com
    .btn-group-vertical(role="group" aria-label="...")
      button#archivebtn.btn.btn-default(type='button') Ver Resultados Anteriores
      button#howbtn.btn.btn-default(type='button') Cómo Jugar
    br
  div.row.justify-content-center
    div.col
      div#joinmenu.d-none
        h5 Unirse a una partida
        form
          .input-container
            label Código de partida:
            .form-group
              input#joinincode.form-control(type='text', placeholder='abcd', autocomplete='off')
            label Nombre:
            .form-group
              input#joininname.form-control(type='text', placeholder='¡Usa tu nombre real!', maxlength=16)
          .btn-toolbar
            button#joinmenu-back.btn.btn-default.btn-lg.mr-2(type='button') Atrás
            button#joinmenu-go.btn.btn-default.btn-lg(type='submit') Unirse
      div#newmenu.d-none
        h5 Crear una partida
        form
          .input-container
            label Nombre:
            .form-group
              input#newinname.form-control(type='text', placeholder='¡Usa tu nombre real!', maxlength=16)
          .btn-toolbar 
            button#newmenu-back.btn.btn-default.btn-lg.mr-2(type='button') Atrás
            button#newmenu-go.btn.btn-default.btn-lg(type='submit') Crear
  div#lobby.d-none
    include announcements.pug
    div.row.justify-content-center.mb-4.mt-3
      div.col-sm-8
        h5 Jugadores
        ul#lobby-players.list-unstyled.row
      .mt-2.btn-group-vertical(role="group" aria-label="...")
        a.btn.btn-default(href="https://drawphone.tannerkrewson.com/archive", target='_blank', type='button') Ver Archivo de Resultados
        button#lobby-prevres.btn.btn-default(type='button').d-none Ver Resultados de la Última Ronda
      .mt-2 Consejo: ¡No hay límite de jugadores que pueden unirse!
    div.row.justify-content-center.mb-3
      div#lobby-settings.col-sm-8.d-none
        h5 Opciones
        label Paquete de palabras:
        select.form-control.lobby-setting#lobby-settings-wordpack.mb-2
          option(disabled='', selected='') Selecciona un paquete de palabras...
          for item in wordpacks
            option #{item}
        label Límite de tiempo para dibujar:
        .btn-toolbar.mb-3
          button#timelimit-minus.lobby-setting.btn.btn-default -
          span#lobby-settings-timelimit Cargando...
          button#timelimit-plus.lobby-setting.btn.btn-default +
        label Número de turnos:
        .btn-toolbar
          button#turnlimit-minus.lobby-setting.btn.btn-default -
          span#lobby-settings-turnlimit Cargando...
          button#turnlimit-plus.lobby-setting.btn.btn-default +
        .mb-3#lobby-settings-gametime Cargando...
        .checkboxes.mb-2
          .custom-control.custom-switch
            input#lobby-settings-wordfirst.custom-control-input.lobby-setting(type='checkbox')
            label.custom-control-label(for='lobby-settings-wordfirst') Los jugadores escriben la primera palabra
          //- TODO: make this work again
            .custom-control.custom-switch
              input#lobby-settings-showNeighbors.custom-control-input.lobby-setting(type='checkbox')
              label.custom-control-label(for='lobby-settings-showNeighbors') Show who players are passing to and from
        .btn-toolbar.mb-3#lobby-settings-bots.d-none
          button#lobby-settings-addbot.btn.btn-default.mr-2(type='button') Añadir Bot
          button#lobby-settings-removebot.btn.btn-default(type='button') Quitar Bot
    .btn-toolbar.mb-4
      button#lobby-leave.btn.btn-default.btn-lg.mr-2(type='button') Salir de la Partida
      button#lobby-start.btn.btn-default.btn-lg.disabled.d-none(type='button') Iniciar Partida
  div#game.d-none
    div#neighboring-players-container.neighboring-players-container
      div#previous-player-container.player-name.d-none
        div Recibiendo de
        div#previous-player
      span#previous-player-arrow
        img(src='arrow-right.svg' alt='right-arrow' width='24')
      div#you-player.player-name
      span#next-player-arrow
        img(src='arrow-right.svg' alt='right-arrow' width='24')
      div#next-player-container.player-name
        div Enviando a
        div#next-player
    div#game-drawing.d-none
      h5#game-timer
      canvas#game-drawing-canvas.drawing(width='600', height='600')
    div#game-word.d-none
      img#game-word-drawingtoname.drawing
      br
      br
      div Introduce tu respuesta aquí:
      input#game-word-in.form-control(type='text', placeholder='¡Toca aquí para escribir!', autocomplete='off')  
    div.row#game-draw-buttons.d-none
      div.col-md-6.mt-2
        div.input-group
          div.input-group-prepend
            span.input-group-text Color
          input#game-drawing-color.form-control(type='color', value='#000000')
          button#game-drawing-recent-color1.form-control(style='background-color: #c71818;')
          button#game-drawing-recent-color2.form-control(style='background-color: #10AC10;')
          button#game-drawing-recent-color3.form-control(style='background-color: #1a79af;')
      div.col-md-6.mt-2
        div.input-group
          div.input-group-prepend
            span.input-group-text Tamaño
          .form-control(style='display: flex;justify-content: center;')
            input#game-drawing-brushsize(type='range', value='5', min='1', max='60')
    .btn-toolbar#game-buttons.d-none.mt-3
      button#game-drawing-undo.btn.btn-default.btn-lg.disabled.mr-2(type='button') Deshacer
      button#game-drawing-redo.btn.btn-default.btn-lg.disabled.mr-2(type='button') Rehacer
      button#game-send.btn.btn-default.btn-lg(type='button') Hecho
  div#result.d-none
    div#result-content
    br
    #result-others.btn-group-vertical(role='group', aria-label='...')
    br
    br
    .btn-toolbar#result-buttons
      button#result-done.btn.btn-default.btn-lg(type='button') Hecho
  div#waiting.d-none
    div.row.justify-content-center
      div.col-sm-8
        h5 Esperando a:
        ul#waiting-players.list-unstyled.row
        div#waiting-hostmsg.d-none
          br
          h5 ¡Eres el anfitrión!
          p ¡Toca la casilla de un jugador para expulsarlo!
        div#waiting-disconnectedmsg.d-none
          br
          h5 ¡Alguien está desconectado!
          p Está marcado con una casilla gris arriba. El juego continuará cuando 
            | alguien se una a esta partida para ocupar su lugar. También puedes 
            | tocar su casilla para reemplazarlo con un bot.
  div#replace.d-none
    div#replace-choices
    br
    .btn-toolbar#replace-buttons
      button#replace-leave.btn.btn-default.btn-lg(type='button') Salir de la Partida
